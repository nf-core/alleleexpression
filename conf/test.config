/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Test data: simulated ASE RNA-seq on a 2 Mb window of GRCh38 chr11 (64.5-66.5 Mb,
    re-based to position 1) for two 1000 Genomes individuals, hosted on Zenodo
    (record 23215419, includes truth tables). Built with tests/scripts/make_ase_sim_data.sh
    and uploaded with tests/scripts/upload_test_data_zenodo.sh. To test a local build,
    override --input with tests/data/ase_sim/samplesheet.csv and the reference
    parameters with the files in tests/data/ase_sim/.

    Use as follows:
        nextflow run nf-core/alleleexpression -profile test,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input         = 'https://zenodo.org/records/23215419/files/samplesheet.csv'

    // Reference (no STAR index: it is built from fasta + gtf)
    fasta         = 'https://zenodo.org/records/23215419/files/genome.fa'
    gtf           = 'https://zenodo.org/records/23215419/files/genes.gtf'
    gene_features = 'https://zenodo.org/records/23215419/files/genes.bed'

    // Phasing
    beagle_ref    = 'https://zenodo.org/records/23215419/files/beagle_ref.chr11.vcf.gz'
    beagle_map    = 'https://zenodo.org/records/23215419/files/genetic_map.chr11.map'

    chromosome    = 'chr11'
    umi_separator = ':'

    multiqc_title = 'Test run'
}
