/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Test data: simulated ASE RNA-seq on a 2 Mb window of GRCh38 chr11 (64.5-66.5 Mb,
    re-based to position 1) for two 1000 Genomes individuals. Regenerate with
    tests/scripts/make_ase_sim_data.sh; ground truth is in tests/data/ase_sim/truth/.

    Use as follows:
        nextflow run nf-core/alleleexpression -profile test,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input         = "${projectDir}/tests/data/ase_sim/samplesheet.csv"

    // Reference
    fasta         = "${projectDir}/tests/data/ase_sim/reference/genome.fa"
    gtf           = "${projectDir}/tests/data/ase_sim/reference/genes.gtf"
    gene_features = "${projectDir}/tests/data/ase_sim/reference/genes.bed"
    star_index    = "${projectDir}/tests/data/ase_sim/reference/star_index"

    // Phasing
    beagle_ref    = "${projectDir}/tests/data/ase_sim/variants/beagle_ref.chr11.vcf.gz"
    beagle_map    = "${projectDir}/tests/data/ase_sim/variants/genetic_map.chr11.map"

    chromosome    = 'chr11'
    umi_separator = ':'

    multiqc_title = 'Test run'
}
