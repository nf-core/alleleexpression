/*
========================================================================================
    Nextflow config file for running nf-test
========================================================================================
    Test inputs come from the `test` profile (conf/test.config), which uses the
    simulated dataset in tests/data/ase_sim. Generate it first with:
        tests/scripts/make_ase_sim_data.sh
----------------------------------------------------------------------------------------
*/

params {
    modules_testdata_base_path   = null
    pipelines_testdata_base_path = null
}
